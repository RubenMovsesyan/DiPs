// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
    {
        "label": "Debug DiPs with test file",
        "build": {
            "command": "cargo",
            "args": ["build"]
        },
        "program": "${ZED_WORKTREE_ROOT}/target/debug/dips",
        "sourceLanguages": ["rust"],
        "request": "launch",
        "adapter": "CodeLLDB",
        "args": [
            "--input=test_files/test.avi",
            "--output=test_files/output.avi"
        ]
    }
]
